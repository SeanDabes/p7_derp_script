#!/bin/bash

ERROR=false
syncderp=false
synckernel=false
poweroff=false
root=false
device=""
jobs=""
start_time=`date`

android_version="bp2a"
derp_repo="https://github.com/DerpFest-AOSP/"
derp_branch="16"
los_branch="lineage-23.0"
los_repo="https://github.com/LineageOS/"
local_manifest_url="git@github.com:SeanDabes/derp_local_manifest_p7.git"

local_manifest_folder="derp_local_manifest_p7"
local_manifest_file="$local_manifest_folder/roomservice_seandabes.xml"
rootfolder=`pwd`
toolsfolder="$rootfolder/tools"
banner_script="$toolsfolder/banner.sh"
monitor_script="$toolsfolder/monitor.sh"
derpfestfolder="$rootfolder/../derpfest" # Change for own one
out_rom_folder="$derpfestfolder/00_latest_builds/"

debloatmkfile="$derpfestfolder/vendor/google/gms/gms-vendor.mk"
debloatmkfilebkp="$debloatmkfile.bak"
debloatbpfile="$derpfestfolder/vendor/google/gms/Android.bp"
debloatbpfilebkp="$debloatbpfile.bak"

# Terminal Colors
readonly BLUE='\033[1;34m'
readonly GREEN='\033[1;32m'
readonly YELLOW='\033[1;33m'
readonly RED='\033[1;31m'
readonly CYAN='\033[1;36m'
readonly MAGENTA='\033[1;35m'
readonly GRAY='\033[1;90m'
readonly WHITE='\033[1;37m'
readonly NOCOLOR='\033[0m'
readonly BOLD='\033[1m'
readonly DIM='\033[2m'
readonly WHITEONBLUE='\033[1;37;44m'
readonly WHITEONMAGENTA='\033[1;37;45m'
readonly WHITEONYELLOW='\033[1;37;43m'
readonly WHITEONCYAN='\033[1;37;46m'
readonly WHITEONRED='\033[1;37;41m'
colors=("$BLUE" "$GREEN" "$YELLOW" "$RED" "$CYAN" "$MAGENTA" "$GRAY" "$WHITE")

chmod +x $banner_script
chmod +x $monitor_script

SECONDS=0 # Timer start

function gcam() { # Change Google Camera for GCam by BSG
    banner
    echo -e "${WHITEONBLUE} MOD: GCAM by BSG                  ${NOCOLOR}"
    echo
    echo "- Checking Google Camera..."
    local camerafolder="$derpfestfolder/vendor/google/camera/proprietary/product/priv-app/GoogleCamera"
    local camerafile="GoogleCamera.apk"
    local bsgcamera="MG9.4.103_V20_MGC.apk"
    local gcamhash="f64522e646e8cbebe503a5ce1eefb60e1596ae45fa5732dfc5f3569d717c91fb"
    if [ ! -f "$camerafolder/$camerafile" ] || [ $(sha256sum "$camerafolder/$camerafile" | cut -d ' ' -f 1) != $gcamhash ]; then
        echo -e "${YELLOW} Gcam not found${NOCOLOR}"
        echo
        echo "- Checking ROM tree..."
        for file in `find | grep $camerafile`; do
            echo $file
            rm $file
        done
        if [ -f $bsgcamera ]; then rm $bsgcamera; fi
        echo "Downloading GCAM from celzoazevedo.com..."
        wget -nv --show-progress https://1-dontsharethislink.celsoazevedo.com/file/filesc/$bsgcamera
        echo "Checking hash..."
        if [ $(sha256sum $bsgcamera | cut -d ' ' -f 1) = $gcamhash ]; then
            echo -e "${GREEN}Cam OK${NOCOLOR}"
            echo "Copying to ROM tree..."
            mv $bsgcamera "$camerafolder/$camerafile"
        else
            echo "Couldn't download!!"
        fi
    else
        echo -e "${GREEN}GCAM from BSG found${NOCOLOR}"
    fi
    sleep 3
}

