#!/bin/bash

syncderp=false
synckernel=false
poweroff=false
device=""
jobs=""
kernelversion="6.1"
kernelsrcfolder=`pwd`"/googlekernel"
derpfestfolder=`pwd`"/derpfest"
kernelfiles=true
gcam="MGC_9.4.103_V20"
gcamhash="f64522e646e8cbebe503a5ce1eefb60e1596ae45fa5732dfc5f3569d717c91fb"

